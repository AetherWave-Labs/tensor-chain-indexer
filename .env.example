# Root/backend environment configuration.
#
# This file documents backend runtime variables only. Never copy values from
# here into frontend/.env.example — only VITE_-prefixed variables are safe
# to expose to the browser bundle (see config/env.ts and frontend/.env.example).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Backend datastore connection string. Required.
DATABASE_URL=postgres://localhost:5432/tensor_chain_indexer

# Blockchain RPC endpoints. Optional until the relevant chain adapter is enabled.
RPC_URL_EVM=
RPC_URL_STELLAR=
